DATABASE_URL=postgresql://rain:rain@localhost:5432/rain

# Region to cover: west,south,east,north (degrees). This is only an example, change it.
BBOX=76.5,12.0,78.5,14.0

# ECMWF's ensemble is ~0.25 degrees (~28 km). A finer step just interpolates.
GRID_STEP=0.25

ENSEMBLE_MODEL=ecmwf_ifs025

# Keep GMT: IMERG observation days are UTC days and the forecasts must match.
TIMEZONE=GMT

# "Rain" means daily total >= this many mm
RAIN_THRESHOLD_MM=1.0

# Which stored model the API shows: lgbm_v1 (app.predict) or ecmwf_ifs025 (raw ensemble, app.ingest)
DISPLAY_MODEL=lgbm_v1

CORS_ORIGINS=http://localhost:5173
